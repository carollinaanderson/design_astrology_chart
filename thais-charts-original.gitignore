    </div>
    <div class="card accent">
      <div class="label" style="color:var(--clay);">triângulo do destino</div>
      <div class="body-txt" style="font-family:'Fraunces',serif; font-style:italic; font-size:17px; margin:5px 0; color:var(--matcha-900);">444 · 888 · 777 (duplo)</div>
